# ═══════════════════════════════════════════════════════════
# سلة المنار — إعدادات Supabase (الخطة المجانية)
# انسخ هذا الملف إلى ".env" في نفس المجلد واملأ قيمك الحقيقية
# من: Supabase Dashboard → Settings → API
# ═══════════════════════════════════════════════════════════

# رابط مشروعك (Settings → API → Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# مفتاح الخادم السري — service_role (Settings → API → service_role key)
# ⚠️ سرّي جداً: لا ترفعه لتطبيقات Flutter ولا تشاركه — الخادم وحده يستخدمه
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.....(ضع مفتاحك الكامل هنا)
